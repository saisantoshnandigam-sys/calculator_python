import tkinter as tk

root = tk.Tk()
root.title('Calcultor')
root.configure(bg='lightblue')

e = tk.Entry(root, width=35, borderwidth=5, bg='lightgray')
e.grid(row=0, column=0, columnspan=4, padx=10, pady=13)


def add(value):
    e.insert(tk.END, value)

def clear():
    e.delete(0, tk.END)

def equal():
    try:
        expression = e.get()
        answer = eval(expression)
        e.delete(0, tk.END)
        e.insert(0, answer)
    except:
        e.delete(0, tk.END)
        e.insert(0, "Error")


b1 = tk.Button(root, text='1', padx=25, pady=5, command=lambda:add("1"), bg='lightblue')
b2 = tk.Button(root, text='2', padx=25, pady=5, command=lambda:add("2"), bg='lightblue')
b3 = tk.Button(root, text='3', padx=25, pady=5, command=lambda:add("3"), bg='lightblue')
b4 = tk.Button(root, text='4', padx=25, pady=5, command=lambda:add("4"), bg='lightblue')
b5 = tk.Button(root, text='5', padx=25, pady=5, command=lambda:add("5"), bg='lightblue')
b6 = tk.Button(root, text='6', padx=25, pady=5, command=lambda:add("6"), bg='lightblue')
b7 = tk.Button(root, text='7', padx=25, pady=5, command=lambda:add("7"), bg='lightblue')
b8 = tk.Button(root, text='8', padx=25, pady=5, command=lambda:add("8"), bg='lightblue')
b9 = tk.Button(root, text='9', padx=25, pady=5, command=lambda:add("9"), bg='lightblue')
b0 = tk.Button(root, text='0', padx=25, pady=5, command=lambda:add("0"), bg='lightblue')

be = tk.Button(root, text='=', padx=25, pady=5, command=equal, bg='lightblue')
bc = tk.Button(root, text='CE', padx=20, pady=5, command=clear, bg='lightblue')
bp = tk.Button(root, text='+', padx=25, pady=5, command=lambda:add("+"), bg='lightblue')
bm = tk.Button(root, text='-', padx=25, pady=5, command=lambda:add("-"), bg='lightblue')
bmp = tk.Button(root, text='X', padx=25, pady=5, command=lambda:add("*"), bg='lightblue')
bd = tk.Button(root, text='/', padx=25, pady=5, command=lambda:add("/"), bg='lightblue')


b1.grid(row=1, column=0)
b2.grid(row=1, column=1)
b3.grid(row=1, column=2)
bc.grid(row=1, column=3)

b4.grid(row=2, column=0)
b5.grid(row=2, column=1)
b6.grid(row=2, column=2)
bd.grid(row=2, column=3)

b7.grid(row=3, column=0)
b8.grid(row=3, column=1)
b9.grid(row=3, column=2)
bmp.grid(row=3, column=3)

b0.grid(row=4, column=0)
bp.grid(row=4, column=1)
bm.grid(row=4, column=2)
be.grid(row=4, column=3)

root.mainloop()
